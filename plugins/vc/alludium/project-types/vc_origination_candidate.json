        }
      ]
    },
    "projectManager": {
      "agentTemplateKey": "vc_origination_manager",
      "displayName": "Origination Candidate Agent",
      "labels": {
        "shortName": "Candidate Agent",
        "chatTitleSuffix": " Origination Candidate Agent",
        "roleNoun": "candidate agent",
        "projectNoun": "origination candidate",
