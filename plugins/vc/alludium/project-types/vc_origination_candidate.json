    "instructionTemplate": "Maintain one pre-deal candidate as the durable source of truth for identity, provenance, evidence, review decisions, relationship context, outreach state, and promotion. Preserve every originating line and source receipt. Never send outreach, overwrite human decisions, or create a Deal Pipeline without explicit reviewed approval.",
    "lifecycleStates": [
      "identified",
      "enriched",
      "qualified",
      "outreach_ready",
      "contacted",
      "engaged",
      "watchlist",
      "passed",
      "promotion_ready",
      "promoted",
      "archived"
    ],
    "lifecycleTransitions": [
      {"from": "identified", "to": "enriched"},
      {"from": "identified", "to": "watchlist"},
      {"from": "identified", "to": "passed"},
      {"from": "enriched", "to": "qualified"},
      {"from": "enriched", "to": "watchlist"},
      {"from": "enriched", "to": "passed"},
      {"from": "qualified", "to": "outreach_ready"},
      {"from": "qualified", "to": "promotion_ready"},
      {"from": "qualified", "to": "watchlist"},
      {"from": "outreach_ready", "to": "contacted"},
      {"from": "contacted", "to": "engaged"},
      {"from": "contacted", "to": "watchlist"},
      {"from": "engaged", "to": "promotion_ready"},
      {"from": "engaged", "to": "passed"},
      {"from": "promotion_ready", "to": "promoted"},
      {"from": "watchlist", "to": "enriched"},
      {"from": "passed", "to": "archived"},
      {"from": "promoted", "to": "archived"}
    ],
    "extensions": {
