{
  "kind": "project-type",
  "apiVersion": "alludium/v1alpha1",
  "key": "vc_origination_candidate",
  "name": "Origination Candidate",
  "description": "A first-class pre-deal company record that consolidates multi-line provenance, evidence, screening, relationship context, outreach state, and reviewed Deal Pipeline promotion.",
  "projectSetup": {
    "setupLabel": "Origination Candidate Registration",
    "starterId": "register-origination-candidate",
    "starterLabel": "Register Candidate",
    "starterResumeLabel": "Continue Candidate Registration",
    "starterDescription": "Normalize one reviewed sourcing result into a durable candidate.",
    "recommendedSetupAgent": "vc_sourcing_operator",
    "requiredEvidence": [
      "candidate_registration"
    ],
    "setupSteps": [
      {
        "key": "candidate_registration",
        "label": "Review candidate identity and provenance",
        "purpose": "Confirm company identity, dedupe key, originating line, source evidence, prior decisions, and do-not-contact status.",
        "stepType": "variables",
        "evidenceKey": "candidate_registration",
        "required": true,
        "taskDefinitionTemplateId": "vc.register_origination_candidate",
        "taskDefinitionSlug": "register-origination-candidate"
      }
    ],
    "postApprovalActions": {
      "applyVariables": {
        "enabled": false,
        "reason": "Candidate registration writes reviewed project fields through deterministic project creation, not workspace variables."
      },
      "importProjects": {
        "enabled": false,
        "reason": "Candidate batch fan-out requires the platform project-relationship API and reviewed import contract."
      },
      "inviteCollaborators": {
        "enabled": false,
        "reason": "Candidate registration does not send invitations."
      },
      "enableSchedules": {
        "enabled": false,
        "reason": "Candidate work is event-driven and individually reviewed; recurring source schedules belong to sourcing lines."
      }
    },
    "scheduleGroups": [],
    "defaultChildTask": {
      "label": "Register candidate",
      "taskDefinitionSlug": "register-origination-candidate",
      "setupGoal": "Confirm one candidate identity, provenance, dedupe result, and relationship context before creating the project."
    },
    "variableDiscoveryTask": {
      "label": "VC Variable Discovery",
      "taskDefinitionTemplateId": "vc.vc_pack_variable_discovery",
      "taskDefinitionSlug": "vc-pack-variable-discovery"
    },
    "sourceSetupTasks": []
  },
  "projectCreation": {
    "launcherLabel": "Register Origination Candidate",
    "starterId": "create-origination-candidate-project",
    "aliases": [
      "origination candidate",
      "sourced company",
      "prospect"
    ],
    "requiredFieldKeys": [
      "company_name",
      "candidate_key",
      "sourcing_line_project_id",
      "relationship_to_line_key",
      "source_evidence_summary"
    ],
    "recommendedFieldKeys": [
      "company_domain",
      "origination_pipeline_project_id",
      "discovered_at"
    ],
    "advancedFieldKeys": [
      "additional_sourcing_line_project_ids",
      "source_record_keys",
      "do_not_contact_status"
    ],
    "defaultState": "identified",
    "guidedTask": {
      "taskDefinitionTemplateId": "vc.register_origination_candidate",
      "taskDefinitionSlug": "register-origination-candidate"
    },
    "postCreate": {
      "triggerInitialStateTasks": true
    }
