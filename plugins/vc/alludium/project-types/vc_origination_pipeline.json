{
  "kind": "project-type",
  "apiVersion": "alludium/v1alpha1",
  "key": "vc_origination_pipeline",
  "name": "Origination Pipeline",
  "description": "The fund-level origination control plane for shared source connections, thesis and review policy, budgets, cross-line Inbox and digest, and creation of first-class Sourcing Lines.",
  "projectSetup": {
    "setupLabel": "Origination Pipeline Setup",
    "starterId": "create-origination",
    "starterLabel": "Create Origination Setup",
    "starterResumeLabel": "Continue Origination Setup",
    "starterDescription": "Create or resume the fund-level Origination Pipeline setup flow.",
    "recommendedSetupAgent": "vc_sourcing_operator",
    "requiredEvidence": [
      "source_choice",
      "source_setup",
      "variables",
      "schedules"
    ],
    "setupSteps": [
      {
        "key": "source_choice",
        "label": "Choose shared source connections",
        "purpose": "Choose approved upstream source providers and connection scopes that sourcing lines may reference.",
        "stepType": "source_choice",
        "evidenceKey": "source_choice",
        "required": true,
        "taskDefinitionSlug": "project-source-choice"
      },
      {
        "key": "source_setup",
        "label": "Set up shared source connections",
        "purpose": "Review credentials, actor or URL scope, budget policy, and read-preview boundaries without defining line experiments or running sourcing.",
        "stepType": "source_setup",
        "evidenceKey": "source_setup",
        "required": true,
        "taskSelection": "sourceSetupTasks"
      },
      {
        "key": "variables",
        "label": "Review fund-level origination policy",
        "purpose": "Review shared thesis, source policy, budget ceilings, candidate review threshold, and promotion policy.",
        "stepType": "variables",
        "evidenceKey": "variables",
        "required": true,
        "taskDefinitionSlug": "project-variable-review"
      },
      {
        "key": "schedules",
        "label": "Configure cross-line schedules",
        "purpose": "Review optional cross-line digest and health tasks; schedules remain disabled until approved.",
        "stepType": "schedules",
        "evidenceKey": "schedules",
        "required": true,
        "taskDefinitionSlug": "project-schedule-review"
      }
    ],
    "postApprovalActions": {
      "applyVariables": {
        "enabled": true,
        "label": "Apply reviewed origination policy",
        "sourceEvidenceKeys": [
          "variables"
        ],
        "target": "workspace_and_project_setup_context",
        "actionMode": "platform_variable_application",
        "requiresReviewedUserApproval": true,
        "setupTasksMayPersistValues": false
      },
      "importProjects": {
        "enabled": false,
        "reason": "The hub does not import companies directly. Reviewed line output creates Origination Candidate projects through a separate action."
      },
      "inviteCollaborators": {
        "enabled": false,
        "reason": "Origination setup does not send invitations."
      },
      "enableSchedules": {
        "enabled": true,
        "label": "Enable approved cross-line schedules",
        "sourceEvidenceKeys": [
          "schedules"
        ],
        "target": "configuredProject",
        "scheduleGroupsRef": "projectSetup.scheduleGroups",
        "defaultEnabled": false,
        "requiresReviewedUserApproval": true,
        "setupTasksMayEnableRecurringSync": false
      }
    },
    "scheduleGroups": [
      {
        "key": "cross_line_reporting",
        "label": "Cross-line reporting",
        "description": "Aggregate reviewed line receipts, degraded sources, candidate attention, and pending approvals without rerunning sources.",
        "taskDefinitionSlugs": [
          "generate-sourcing-digest"
        ],
        "defaultExpanded": true,
        "advanced": false
      }
    ],
    "defaultChildTask": {
      "label": "Review origination control plane",
      "taskDefinitionSlug": "configure-origination-pipeline",
      "setupGoal": "Review shared sources, budgets, approval policy, and cross-line reporting. New Sourcing Lines use their own project creation launcher and canonical chat."
    },
    "variableDiscoveryTask": {
      "label": "VC Variable Discovery",
      "taskDefinitionTemplateId": "vc.vc_pack_variable_discovery",
      "taskDefinitionSlug": "vc-pack-variable-discovery"
    },
    "sourceSetupTasks": [
      {
        "applicationRecommendationId": "apify-actors-mcp",
        "applicationExternalId": "apify-actors-mcp",
        "label": "Set Up Apify For Shared Origination Sources",
        "setupGoal": "Confirm connection readiness, actor allowlist, approved scopes, and read-preview policy. Sourcing lines later reference the registered source keys.",
        "taskDefinitionTemplateId": "vc.apify_setup",
        "taskDefinitionSlug": "apify-setup"
      },
      {
        "applicationRecommendationId": "firecrawl-mcp-hosted",
        "applicationExternalId": "firecrawl-mcp-hosted",
        "label": "Configure Companies House Public Register Preview",
        "setupGoal": "Confirm the shared public-register connection scope and read-preview policy. Sourcing lines later define queries and cadence.",
        "taskDefinitionTemplateId": "vc.companies_house_setup",
        "taskDefinitionSlug": "companies-house-setup"
      }
    ]
  },
  "projectCreation": {
    "launcherLabel": "Create Origination Pipeline",
    "starterId": "create-origination-pipeline-project",
    "aliases": [
      "origination pipeline",
      "origination workspace",
      "sourcing control plane"
    ],
    "requiredFieldKeys": [
      "pipeline_name"
    ],
    "recommendedFieldKeys": [
      "source_registry",
      "review_policy"
    ],
    "advancedFieldKeys": [
      "confidentiality_level"
    ],
    "defaultState": "draft",
    "guidedTask": {
      "taskDefinitionTemplateId": "vc.configure_origination_pipeline",
      "taskDefinitionSlug": "configure-origination-pipeline"
    },
    "postCreate": {
      "triggerInitialStateTasks": true
    }
  },
  "initialVersion": {
    "version": "0.3.1",
    "documentLibrary": {
      "catalogPath": "alludium/documents/catalog.v1.json",
      "documentIds": [
        "vc.document.investment_screening_framework",
        "vc.document.investment_diligence_question_framework",
        "vc.document.evidence_citation_style_guide",
        "vc.document.template_use_guidance",
        "vc.document.file_naming_source_index_sop",
        "vc.document.lead_generation_packet_template",
        "vc.document.origination_pipeline_sop",
        "vc.document.origination_source_strategy_guide",
        "vc.document.source_registry_template",
        "vc.document.sourcing_line_template_catalog",
        "vc.document.source_health_review_checklist",
        "vc.document.paid_source_spend_audit_checklist",
        "vc.document.sourcing_digest_template",
        "vc.document.apify_source_setup_checklist",
        "vc.document.companies_house_source_setup_checklist"
      ]
    },
    "fieldsSchema": [
      {
        "id": "field-pipeline-name",
        "key": "pipeline_name",
        "label": "Pipeline Name",
        "kind": "text",
        "required": true
      },
      {
        "id": "field-source-registry",
        "key": "source_registry",
        "label": "Shared Source Registry",
        "kind": "text",
        "required": false,
        "description": "Reusable source connections and approved scopes. Query, screen, cadence, review, and outreach configuration belong to sourcing lines."
      },
      {
        "id": "field-review-policy",
        "key": "review_policy",
        "label": "Fund-Level Review Policy",
        "kind": "text",
        "required": false
      },
      {
        "id": "field-line-relationship-key",
        "key": "sourcing_line_relationship_key",
        "label": "Sourcing Line Relationship Key",
        "kind": "text",
        "required": false,
        "placeholder": "vc.origination_pipeline_contains_sourcing_line"
      },
      {
        "id": "field-active-line-count",
        "key": "active_line_count",
        "label": "Active Sourcing Lines",
        "kind": "number",
        "required": false
      },
      {
        "id": "field-attention-candidate-count",
        "key": "attention_candidate_count",
        "label": "Candidates Needing Attention",
        "kind": "number",
        "required": false
      },
      {
        "id": "field-latest-digest",
        "key": "latest_digest_artifact_id",
        "label": "Latest Origination Digest",
        "kind": "text",
        "required": false
      },
      {
        "id": "field-latest-source-health",
        "key": "latest_source_health_artifact_id",
        "label": "Latest Shared Source Health Review",
        "kind": "text",
        "required": false
      },
      {
        "id": "field-source-health-status",
        "key": "source_health_status",
        "label": "Shared Source Health",
        "kind": "enum",
        "required": false,
        "options": [
          {"value": "healthy", "label": "Healthy"},
          {"value": "degraded", "label": "Degraded"},
          {"value": "needs_credentials", "label": "Needs Credentials"},
          {"value": "budget_blocked", "label": "Budget Blocked"},
          {"value": "unknown", "label": "Unknown"}
        ]
      },
      {
        "id": "field-owner",
        "key": "owner",
        "label": "Owner",
        "kind": "member",
        "required": false
      },
      {
        "id": "field-confidentiality",
        "key": "confidentiality_level",
        "label": "Confidentiality",
        "kind": "enum",
        "required": false,
        "options": [
          {"value": "standard", "label": "Standard"},
          {"value": "restricted", "label": "Restricted"}
        ]
      }
    ],
    "instructionTemplate": "Operate this project as the fund-level origination control plane. Maintain shared source registrations, policies, budgets, the cross-line Inbox, and aggregate reporting. Create a dedicated Sourcing Line project and chat for every repeatable experiment. Create a durable Origination Candidate project for each reviewed company. Do not store candidate funnel state or line schedules on this hub.",
    "lifecycleStates": [
      "draft",
      "configured",
      "active",
      "degraded",
      "paused",
      "archived"
    ],
    "lifecycleTransitions": [
      {"from": "draft", "to": "configured"},
      {"from": "configured", "to": "active"},
      {"from": "active", "to": "degraded"},
      {"from": "degraded", "to": "active"},
      {"from": "active", "to": "paused"},
      {"from": "paused", "to": "active"},
      {"from": "paused", "to": "archived"}
    ],
    "extensions": {
      "projectRelationships": [
        {
          "typeKey": "vc.origination_pipeline_contains_sourcing_line",
          "label": "Contains sourcing line",
          "inverseLabel": "Belongs to origination pipeline",
          "description": "Connects the fund-level origination control plane to a first-class sourcing experiment.",
          "targetProjectTypeKeys": [
            "vc_sourcing_line"
          ]
        }
      ]
    },
    "projectManager": {
      "agentTemplateKey": "vc_origination_manager",
      "displayName": "Origination Manager",
      "labels": {
        "shortName": "Origination",
        "chatTitleSuffix": " Origination Manager",
        "roleNoun": "origination manager",
        "projectNoun": "origination pipeline",
        "collectionNoun": "origination",
        "taskShortcutLabel": "New origination task"
      },
      "identity": {
        "roleDescription": "Provides fund-wide awareness across sourcing lines, candidate attention, shared sources, budgets, and promotion activity.",
        "tone": "Calm, concise, evidence-led, and proactive about the most important human decisions.",
        "responsibilities": [
          "Maintain the shared source registry, thesis, budgets, and approval policy.",
          "Create and compare sourcing lines without collapsing them into provider configurations.",
          "Surface the most important candidates and degraded lines in the cross-line Inbox."
        ],
        "boundaries": [
          "Do not run source queries directly on the hub.",
          "Do not store candidate funnel state on the hub.",
          "Do not enable schedules, spend money, send outreach, or create downstream projects without approval."
        ]
      },
      "greeting": {
        "message": "I'm your **Origination Manager**. I manage origination across your sourcing lines and candidates, with the current configuration, runs, costs, and approvals in context.",
        "instructions": "Lead with what needs attention. Use dedicated line and candidate projects for detailed work.",
        "starterPrompts": [
          "What needs my attention today?",
          "Start a new sourcing line chat.",
          "Compare line performance and cost.",
          "Show degraded sources and blocked runs.",
          "Which candidates are ready for Deal Pipeline review?"
        ]
      }
    },
    "projectTaskMappings": [
      {
        "id": "mapping-generate-cross-line-digest",
        "taskDefinitionSlug": "generate-sourcing-digest",
        "taskDefinitionTemplateId": "vc.generate_sourcing_digest",
        "lifecycleStage": "active",
        "projectScope": "project_instance",
        "activationPolicy": {
          "mode": "manual_review",
          "autoStartWhenRequiredInputsAvailable": false,
          "requiresHumanApproval": true,
          "createTaskWhenLifecycleStageEntered": false
        },
        "inputMappings": [
          {"taskField": "digest_scope", "source": "project.id", "requiredForActivation": true}
        ],
        "outputMappings": [
          {"taskField": "active_line_count", "target": "project.field", "targetPath": "active_line_count"},
          {"taskField": "attention_candidate_count", "target": "project.field", "targetPath": "attention_candidate_count"},
          {"taskField": "sourcing_digest_artifact_id", "target": "project.field", "targetPath": "latest_digest_artifact_id"}
        ]
      },
      {
        "id": "mapping-review-shared-source-health",
        "taskDefinitionSlug": "review-source-errors-and-spend",
        "taskDefinitionTemplateId": "vc.review_source_errors_and_spend",
        "lifecycleStage": "degraded",
        "projectScope": "project_instance",
        "activationPolicy": {
          "mode": "manual_review",
          "autoStartWhenRequiredInputsAvailable": false,
          "requiresHumanApproval": true,
          "createTaskWhenLifecycleStageEntered": false
        },
        "inputMappings": [
          {"taskField": "source_health_scope", "source": "project.id", "requiredForActivation": true}
        ],
        "outputMappings": [
          {"taskField": "source_health_artifact_id", "target": "project.field", "targetPath": "latest_source_health_artifact_id"},
          {"taskField": "source_health_status", "target": "project.field", "targetPath": "source_health_status"}
        ]
      }
    ]
  }
}
