{
  "kind": "project-type",
  "apiVersion": "alludium/v1alpha1",
  "key": "vc_sourcing_line",
  "name": "Sourcing Line",
  "description": "A fund-specific, measurable origination experiment with its own sources, screen, cadence, evidence receipts, review policy, and learning history.",
  "projectSetup": {
    "setupLabel": "Sourcing Line Setup",
    "starterId": "configure-sourcing-line",
    "starterLabel": "Configure Sourcing Line",
    "starterResumeLabel": "Continue Sourcing Line Setup",
    "starterDescription": "Shape one repeatable sourcing experiment for a configured Fund.",
    "recommendedSetupAgent": "vc_sourcing_line_manager",
    "requiredEvidence": ["variables", "schedules"],
    "setupSteps": [
      {
        "key": "variables",
        "label": "Shape the sourcing experiment",
        "purpose": "Review the Fund, hypothesis, sources, screen, cadence, review policy, outreach boundary, and success measures.",
        "stepType": "variables",
        "evidenceKey": "variables",
        "required": true,
        "taskDefinitionTemplateId": "vc.configure_sourcing_line",
        "taskDefinitionSlug": "configure-sourcing-line"
      },
      {
        "key": "schedules",
        "label": "Review sourcing-line schedules",
        "purpose": "Review the recurring line run; every schedule remains disabled until explicitly approved.",
        "stepType": "schedules",
        "evidenceKey": "schedules",
        "required": true,
        "taskDefinitionSlug": "project-schedule-review"
      }
    ],
    "postApprovalActions": {
      "applyVariables": {
        "enabled": true,
        "label": "Apply reviewed sourcing-line configuration",
        "sourceEvidenceKeys": ["variables"],
        "target": "workspace_and_project_setup_context",
        "actionMode": "platform_variable_application",
        "requiresReviewedUserApproval": true,
        "setupTasksMayPersistValues": false
      },
      "importProjects": {
        "enabled": false,
        "reason": "A sourcing-line run proposes candidates; candidate project creation is a separately reviewed platform action."
      },
      "inviteCollaborators": {
        "enabled": false,
        "reason": "Line setup does not send invitations."
      },
      "enableSchedules": {
        "enabled": true,
        "label": "Enable approved sourcing-line schedules",
        "sourceEvidenceKeys": ["schedules"],
        "target": "configuredProject",
        "scheduleGroupsRef": "projectSetup.scheduleGroups",
        "defaultEnabled": false,
        "requiresReviewedUserApproval": true,
        "setupTasksMayEnableRecurringSync": false
      }
    },
    "scheduleGroups": [
      {
        "key": "line_execution",
        "label": "Line execution",
        "description": "Run this Fund-specific sourcing hypothesis and retain line-scoped receipts and candidate proposals.",
        "taskDefinitionSlugs": ["run-vc-sourcing-pipeline"],
        "defaultExpanded": true,
        "advanced": false
      }
    ],
    "defaultChildTask": {
      "label": "Configure sourcing line",
      "taskDefinitionSlug": "configure-sourcing-line",
      "setupGoal": "Shape one measurable Fund-specific sourcing experiment before any source run, schedule enablement, candidate creation, or outreach."
    },
    "variableDiscoveryTask": {
      "label": "VC Variable Discovery",
      "taskDefinitionTemplateId": "vc.vc_pack_variable_discovery",
      "taskDefinitionSlug": "vc-pack-variable-discovery"
    },
    "sourceSetupTasks": []
  },
  "projectCreation": {
    "launcherLabel": "Create Sourcing Line",
    "starterId": "create-sourcing-line-project",
    "aliases": ["sourcing line", "sourcing experiment", "origination search"],
    "requiredFieldKeys": ["line_name", "fund_id"],
    "recommendedFieldKeys": ["starter_template_key", "line_hypothesis", "source_keys", "screen_definition", "cadence_policy", "review_policy", "outreach_policy", "success_metrics", "review_date"],
    "advancedFieldKeys": ["result_limit", "budget_limit", "timezone", "retirement_condition"],
    "defaultState": "draft",
    "guidedTask": {
      "taskDefinitionTemplateId": "vc.create_sourcing_line",
      "taskDefinitionSlug": "create-sourcing-line"
    },
    "postCreate": {"triggerInitialStateTasks": true}
  },
