          {"taskField": "candidate_batch_artifact_id", "target": "project.field", "targetPath": "latest_candidate_batch_artifact_id"},
          {"taskField": "source_state_artifact_id", "target": "project.field", "targetPath": "latest_source_state_artifact_id"}
