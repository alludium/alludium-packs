{
  "kind": "project-type",
  "apiVersion": "alludium/v1alpha1",
  "key": "vc_sourcing_line",
  "name": "Sourcing Line",
  "description": "A first-class, measurable origination experiment with its own chat, source mix, screen, cadence, review policy, outreach boundary, schedules, receipts, and performance history.",
  "projectSetup": {
    "setupLabel": "Sourcing Line Setup",
    "starterId": "create-sourcing-line",
    "starterLabel": "Create Sourcing Line",
    "starterResumeLabel": "Continue Sourcing Line Setup",
    "starterDescription": "Shape or resume one repeatable sourcing experiment through chat.",
    "recommendedSetupAgent": "vc_sourcing_operator",
    "requiredEvidence": [
      "variables",
      "schedules"
    ],
    "setupSteps": [
      {
        "key": "variables",
        "label": "Shape the sourcing experiment",
        "purpose": "Review the line hypothesis, source mix, query or screen, cadence, review policy, outreach boundary, and success measures.",
        "stepType": "variables",
        "evidenceKey": "variables",
        "required": true,
        "taskDefinitionTemplateId": "vc.configure_sourcing_line",
        "taskDefinitionSlug": "configure-sourcing-line"
      },
      {
        "key": "schedules",
        "label": "Review sourcing-line schedules",
        "purpose": "Review the recurring line orchestrator; every schedule remains disabled until explicitly approved.",
        "stepType": "schedules",
        "evidenceKey": "schedules",
        "required": true,
        "taskDefinitionSlug": "project-schedule-review"
      }
    ],
    "postApprovalActions": {
      "applyVariables": {
        "enabled": true,
        "label": "Apply reviewed sourcing-line configuration",
        "sourceEvidenceKeys": [
          "variables"
        ],
        "target": "workspace_and_project_setup_context",
        "actionMode": "platform_variable_application",
        "requiresReviewedUserApproval": true,
        "setupTasksMayPersistValues": false
      },
      "importProjects": {
        "enabled": false,
        "reason": "A sourcing-line run proposes candidates; candidate project creation is a separately reviewed platform action."
      },
      "inviteCollaborators": {
        "enabled": false,
        "reason": "Line setup does not send invitations."
      },
      "enableSchedules": {
        "enabled": true,
        "label": "Enable approved sourcing-line schedules",
        "sourceEvidenceKeys": [
          "schedules"
        ],
        "target": "configuredProject",
        "scheduleGroupsRef": "projectSetup.scheduleGroups",
        "defaultEnabled": false,
        "requiresReviewedUserApproval": true,
        "setupTasksMayEnableRecurringSync": false
      }
    },
    "scheduleGroups": [
      {
        "key": "line_execution",
        "label": "Line execution",
        "description": "Run the approved line hypothesis and retain line-scoped receipts and candidate proposals.",
        "taskDefinitionSlugs": [
          "run-vc-sourcing-pipeline"
        ],
        "defaultExpanded": true,
        "advanced": false
      }
    ],
    "defaultChildTask": {
      "label": "Configure sourcing line",
      "taskDefinitionSlug": "configure-sourcing-line",
      "setupGoal": "Shape one measurable sourcing experiment before any source run, schedule enablement, candidate creation, or outreach."
    },
    "variableDiscoveryTask": {
      "label": "VC Variable Discovery",
      "taskDefinitionTemplateId": "vc.vc_pack_variable_discovery",
      "taskDefinitionSlug": "vc-pack-variable-discovery"
    },
    "sourceSetupTasks": []
  },
  "projectCreation": {
    "launcherLabel": "Start a Sourcing Line Chat",
    "starterId": "create-sourcing-line-project",
    "aliases": [
      "sourcing line",
      "sourcing experiment",
      "origination search"
    ],
    "requiredFieldKeys": [
      "line_name",
      "origination_pipeline_project_id",
      "relationship_to_pipeline_key"
    ],
    "recommendedFieldKeys": [
      "starter_template_key",
      "line_hypothesis",
      "source_keys",
      "screen_definition",
      "cadence_policy",
      "review_policy",
      "outreach_policy",
      "success_metrics",
      "cursor_window_policy",
      "inbox_threshold",
      "review_date"
    ],
    "advancedFieldKeys": [
      "result_limit",
      "budget_limit",
      "timezone",
      "retirement_condition"
    ],
    "defaultState": "draft",
    "guidedTask": {
      "taskDefinitionTemplateId": "vc.create_sourcing_line",
      "taskDefinitionSlug": "create-sourcing-line"
    },
    "postCreate": {
      "triggerInitialStateTasks": true
    }
  },
  "initialVersion": {
    "version": "0.1.2",
    "documentLibrary": {
      "catalogPath": "alludium/documents/catalog.v1.json",
      "documentIds": [
        "vc.document.origination_pipeline_sop",
        "vc.document.origination_source_strategy_guide",
        "vc.document.source_registry_template",
        "vc.document.sourcing_line_template_catalog",
        "vc.document.candidate_batch_template",
        "vc.document.source_health_review_checklist",
        "vc.document.paid_source_spend_audit_checklist",
        "vc.document.template_use_guidance",
        "vc.document.evidence_citation_style_guide",
        "vc.document.thesis_target_list_template"
      ]
    },
