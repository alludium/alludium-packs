    "fieldsSchema": [
      {"id": "field-line-name", "key": "line_name", "label": "Line Name", "kind": "text", "required": true},
      {
        "id": "field-fund-id",
        "key": "fund_id",
        "label": "Fund",
        "kind": "text",
        "required": true,
        "description": "Stable id of the active Fund whose mandate governs this sourcing line. The value must match one active record in vc.funds.",
        "optionSource": {
          "type": "workspaceVariableCollection",
          "path": "vc.funds",
          "valueKey": "id",
          "labelKey": "name",
          "statusKey": "status",
          "selectableStatuses": ["actively_investing"],
          "hintKeys": ["stage", "sectors", "geographies"]
        }
      },
      {"id": "field-template-key", "key": "starter_template_key", "label": "Starter Template", "kind": "enum", "required": false, "options": [
        {"value": "thesis_radar", "label": "Thesis Radar"},
        {"value": "trigger_event_watch", "label": "Trigger And Event Watch"},
        {"value": "builder_signal_convergence", "label": "Builder-Signal Convergence"},
        {"value": "ecosystem_community_scout", "label": "Ecosystem And Community Scout"},
        {"value": "relationship_reactivation", "label": "Relationship-Led Reactivation"},
        {"value": "targeted_outbound_experiment", "label": "Targeted Outbound Message Experiment"},
        {"value": "custom", "label": "Custom"}
      ]},
      {"id": "field-line-hypothesis", "key": "line_hypothesis", "label": "Line Hypothesis", "kind": "text", "required": false},
      {"id": "field-source-keys", "key": "source_keys", "label": "Registered Source Keys", "kind": "text", "required": false},
      {"id": "field-screen-definition", "key": "screen_definition", "label": "Query And Screen", "kind": "text", "required": false},
      {"id": "field-cadence-policy", "key": "cadence_policy", "label": "Cadence Policy", "kind": "text", "required": false},
      {"id": "field-review-policy", "key": "review_policy", "label": "Review And Inbox Policy", "kind": "text", "required": false},
      {"id": "field-outreach-policy", "key": "outreach_policy", "label": "Outreach Policy", "kind": "text", "required": false},
      {"id": "field-success-metrics", "key": "success_metrics", "label": "Success Metrics", "kind": "text", "required": false},
      {"id": "field-result-limit", "key": "result_limit", "label": "Result Limit", "kind": "number", "required": false},
      {"id": "field-inbox-threshold", "key": "inbox_threshold", "label": "Inbox Threshold", "kind": "number", "required": false},
      {"id": "field-budget-limit", "key": "budget_limit", "label": "Budget Limit", "kind": "number", "required": false},
      {"id": "field-timezone", "key": "timezone", "label": "Timezone", "kind": "text", "required": false},
      {"id": "field-review-date", "key": "review_date", "label": "Review Date", "kind": "date", "required": false},
      {"id": "field-retirement-condition", "key": "retirement_condition", "label": "Retirement Condition", "kind": "text", "required": false},
      {"id": "field-last-run-at", "key": "last_run_at", "label": "Last Run At", "kind": "date", "required": false},
      {"id": "field-last-run-status", "key": "last_run_status", "label": "Last Run Status", "kind": "enum", "required": false, "options": [
