    "instructionTemplate": "Operate one sourcing line as a measurable experiment. Keep source connections in the parent Origination Pipeline registry; keep query, screen, cadence, review, outreach, receipts, and learning history on this line. Never enable schedules, exceed budgets, create candidates, write external systems, or send outreach without the required human approval.",
    "lifecycleStates": [
      "draft",
      "ready",
      "active",
      "degraded",
      "paused",
      "retired",
      "archived"
    ],
    "lifecycleTransitions": [
      {"from": "draft", "to": "ready"},
      {"from": "draft", "to": "paused"},
      {"from": "paused", "to": "ready"},
      {"from": "ready", "to": "active"},
      {"from": "active", "to": "degraded"},
      {"from": "degraded", "to": "active"},
      {"from": "active", "to": "paused"},
      {"from": "paused", "to": "active"},
      {"from": "paused", "to": "retired"},
      {"from": "retired", "to": "archived"}
    ],
    "extensions": {
      "projectRelationships": [
        {
          "typeKey": "vc.sourcing_line_originated_candidate",
          "label": "Originated candidate",
          "inverseLabel": "Originated by sourcing line",
          "description": "Attributes a durable candidate to a sourcing experiment while allowing the candidate to retain additional line provenance.",
          "targetProjectTypeKeys": [
            "vc_origination_candidate"
          ]
        }
      ],
      "sourcingLineTemplates": [
        {
          "key": "thesis_radar",
          "label": "Thesis Radar",
          "summary": "Persistent thesis coverage across structured company data and first-party evidence.",
          "starterPrompt": "Create a Thesis Radar sourcing line. Help me turn our thesis, geography, stage, exclusions, and review threshold into a measurable weekly experiment.",
          "defaultHypothesis": "A persistent thesis screen will surface novel, qualified companies earlier than inbound coverage alone.",
          "sourceCategories": ["structured_company_data", "first_party_web", "company_registry"],
          "defaultCadence": "weekly_full_with_daily_incremental",
          "defaultOutreachMode": "disabled"
        },
        {
          "key": "trigger_event_watch",
          "label": "Trigger And Event Watch",
          "summary": "Time-sensitive monitoring for incorporations, launches, hiring, grants, funding, or regulatory events.",
          "starterPrompt": "Create a Trigger And Event Watch line. Ask me which events matter, how fresh they must be, and what independent verification is required.",
          "defaultHypothesis": "A small set of verified change events predicts a worthwhile conversation early enough to act.",
          "sourceCategories": ["event_feeds", "company_registry", "first_party_web"],
          "defaultCadence": "daily",
          "defaultOutreachMode": "disabled"
        },
        {
          "key": "builder_signal_convergence",
          "label": "Builder-Signal Convergence",
          "summary": "Combine public technical activity with identity and commercial-intent evidence.",
          "starterPrompt": "Create a Builder-Signal Convergence line. Help me define the technical, founder, and commercial signals that must converge before a candidate reaches the Inbox.",
          "defaultHypothesis": "Two independent builder and commercial-intent signals identify credible technical founders before conventional databases.",
          "sourceCategories": ["developer_ecosystem", "professional_identity", "first_party_web"],
          "defaultCadence": "weekly",
          "defaultOutreachMode": "draft_only"
        },
        {
          "key": "ecosystem_community_scout",
          "label": "Ecosystem And Community Scout",
          "summary": "Discover emerging founders in reviewed communities, accelerators, events, universities, and forums.",
          "starterPrompt": "Create an Ecosystem And Community Scout line. Ask me which communities are in scope, what counts as a builder signal, and how we will verify identity and company claims.",
          "defaultHypothesis": "Specific communities and builder-language patterns yield novel, thesis-fit candidates when independently verified.",
          "sourceCategories": ["community", "social", "accelerator_or_university", "first_party_web"],
          "defaultCadence": "weekly",
          "defaultOutreachMode": "draft_only"
        },
        {
          "key": "relationship_reactivation",
          "label": "Relationship-Led Reactivation",
          "summary": "Revisit known companies and people only when material new evidence changes the case.",
          "starterPrompt": "Create a Relationship-Led Reactivation line. Help me define the prior cohorts, material-change triggers, recontact window, relationship owner, and do-not-contact rules.",
          "defaultHypothesis": "Material change signals can identify the right moment to reopen previously watched or passed relationships.",
          "sourceCategories": ["crm_relationships", "public_change_signals"],
          "defaultCadence": "monthly",
          "defaultOutreachMode": "relationship_owner_approval"
        },
        {
          "key": "targeted_outbound_experiment",
          "label": "Targeted Outbound Message Experiment",
          "summary": "Test evidence-backed message variants on a small, reviewed candidate cohort.",
          "starterPrompt": "Create a Targeted Outbound Message Experiment. Help me define a narrow cohort, message variants, approval boundary, sample size, reply classes, opt-out handling, and success metrics.",
          "defaultHypothesis": "A specific evidence-backed proposition will produce more qualified replies than the current baseline for a tightly defined cohort.",
          "sourceCategories": ["reviewed_candidate_cohort", "relationship_context"],
          "defaultCadence": "finite_batch_or_weekly",
          "defaultOutreachMode": "human_approved_batch"
        }
      ]
    },
    "projectManager": {
      "agentTemplateKey": "vc_origination_manager",
      "displayName": "Sourcing Line Agent",
      "labels": {
        "shortName": "Line Agent",
        "chatTitleSuffix": " Sourcing Line Agent",
        "roleNoun": "sourcing line agent",
        "projectNoun": "sourcing line",
        "collectionNoun": "sourcing lines",
        "taskShortcutLabel": "New line task"
      },
      "identity": {
        "roleDescription": "Owns the context, execution history, and learning loop for one sourcing experiment.",
        "tone": "Concise, evidence-led, experimentally minded, and explicit about approval boundaries.",
        "responsibilities": [
          "Maintain the line hypothesis, sources, screen, cadence, thresholds, and success measures.",
          "Explain every run, candidate proposal, source degradation, cost, and learning in line context.",
          "Prepare reviewed candidate creation proposals and draft-only outreach experiments."
        ],
        "boundaries": [
          "Do not enable schedules or paid reads without approval.",
          "Do not create candidate projects or write external systems without reviewed approval.",
          "Do not send outreach automatically."
        ]
      },
      "greeting": {
        "message": "I manage this sourcing line and retain its hypothesis, configuration, runs, candidates, costs, and learnings.",
        "instructions": "Ground answers in this line's configuration and receipts; separate proposed changes from approved execution.",
        "starterPrompts": [
          "What changed since the last run?",
          "Show the candidates that most need review.",
          "How is this line performing against its hypothesis?",
          "Propose a safe change to the screen or message experiment."
        ]
      }
    },
