{
  "kind": "project-type",
  "apiVersion": "alludium/v1alpha1",
  "key": "vc_deal_pipeline",
  "name": "VC Deal Pipeline",
  "description": "A simplified, evidence-led VC Deal Pipeline with stage-independent living documents from screening through term-sheet review.",
  "projectSetup": {
    "setupLabel": "VC Deal Pipeline Setup",
    "starterId": "create-vc-deal-pipeline",
    "starterLabel": "Create VC Deal Pipeline Setup",
    "starterResumeLabel": "Continue VC Deal Pipeline Setup",
    "starterDescription": "Create or resume the simplified VC Deal Pipeline setup flow.",
    "recommendedSetupAgent": "vc_deal_pipeline_manager",
    "requiredEvidence": ["variables", "invite"],
    "setupSteps": [
      {
        "key": "variables",
        "label": "Review variables",
        "purpose": "Review Fund and firm variables before Deal work starts.",
        "stepType": "variables",
        "evidenceKey": "variables",
        "required": true,
        "taskDefinitionSlug": "project-variable-review"
      },
      {
        "key": "invite",
        "label": "Invite team",
        "purpose": "Review Deal collaborator suggestions without sending invitations.",
        "stepType": "invite",
        "evidenceKey": "invite",
        "required": true,
        "taskDefinitionSlug": "project-team-invite"
      }
    ],
    "postApprovalActions": {
      "applyVariables": {
        "enabled": true,
        "label": "Apply reviewed VC variables",
        "sourceEvidenceKeys": ["variables"],
        "target": "workspace_and_created_projects",
        "actionMode": "platform_variable_application",
        "requiresReviewedUserApproval": true,
        "setupTasksMayPersistValues": false
      },
      "importProjects": {
        "enabled": false,
        "reason": "Deal creation is handled by the reviewed guided creation flow rather than setup import."
      },
      "inviteCollaborators": {
        "enabled": true,
        "label": "Invite approved Deal collaborators",
        "sourceEvidenceKeys": ["invite"],
        "target": "createdProjects",
        "actionMode": "platform_project_membership",
        "requiresReviewedUserApproval": true,
        "setupTasksMaySendInvites": false
      },
      "enableSchedules": {
        "enabled": false,
        "reason": "This project type has no recurring or stage-entry task creation."
      }
    },
    "scheduleGroups": [],
    "variableDiscoveryTask": {
      "label": "VC Variable Discovery",
      "taskDefinitionTemplateId": "vc.vc_pack_variable_discovery",
      "taskDefinitionSlug": "vc-pack-variable-discovery"
    }
  },
  "projectCreation": {
    "launcherLabel": "Create VC Deal Pipeline",
    "starterId": "create-pipeline-deal",
    "aliases": ["vc deal pipeline", "simplified deal pipeline", "investment opportunity"],
    "requiredFieldKeys": [],
    "recommendedFieldKeys": ["fund_id", "deal_source"],
    "advancedFieldKeys": [],
    "defaultState": "screening",
    "guidedTask": {
      "taskDefinitionTemplateId": "vc.create_pipeline_deal",
      "taskDefinitionSlug": "create-pipeline-deal"
    },
    "postCreate": {"triggerInitialStateTasks": false}
  },
  "initialVersion": {
    "version": "1.0.9",
    "documentLibrary": {
      "catalogPath": "alludium/documents/catalog.v1.json",
      "documentIds": [
        "vc.document.evidence_citation_style_guide",
        "vc.document.template_use_guidance",
        "vc.document.deal_pipeline_screening_criteria",
        "vc.document.deal_pipeline_screening_report_template",
        "vc.document.deal_pipeline_evaluation_criteria",
        "vc.document.deal_pipeline_evaluation_report_template",
        "vc.document.deal_pipeline_ic_criteria",
        "vc.document.deal_pipeline_ic_memo_template",
        "vc.document.deal_pipeline_decision_record_template",
        "vc.document.deal_pipeline_term_sheet_review_policy",
        "vc.document.deal_pipeline_term_sheet_review_template",
        "vc.document.initial_call_brief_template",
        "vc.document.customer_insights_summary_template"
      ],
      "presentation": {
        "title": "VC Deal Pipeline documents",
        "description": "Configure the methodology, guidance, policies, and output templates used by the workspace-selected VC Deal Pipeline.",
        "groups": [
          {"key":"shared_guidance","label":"Shared guidance","description":"Cross-cutting evidence, citation, and template-use guidance.","sortOrder":10},
          {"key":"screening","label":"Screening","description":"Criteria and report format for the first investment screen.","sortOrder":20},
          {"key":"evaluation","label":"Evaluation","description":"Methodology and living report format for deeper evaluation.","sortOrder":30},
          {"key":"decision","label":"Decision","description":"IC preparation, memo, and confirmed decision-record formats.","sortOrder":40},
          {"key":"term_sheet","label":"Term Sheet","description":"Review policy and output format for supplied term sheets.","sortOrder":50},
          {
            "key": "meetings",
            "label": "Meetings",
            "description": "Briefs and summaries for individual Deal meetings.",
            "sortOrder": 60
          }
        ],
        "documents": [
          {"documentId":"vc.document.evidence_citation_style_guide","roleKey":"shared_evidence_citation_guidance","groupKey":"shared_guidance","displayName":"Evidence and citation guidance","description":"Citation, assumption, source-authority, and claim-hygiene guidance shared across Deal documents.","kind":"guidance","sortOrder":10},
          {"documentId":"vc.document.template_use_guidance","roleKey":"shared_template_use_guidance","groupKey":"shared_guidance","displayName":"Template use guidance","description":"Guidance for adapting Deal templates to available evidence without producing generic filler.","kind":"guidance","sortOrder":20},
          {"documentId":"vc.document.deal_pipeline_screening_criteria","roleKey":"screening_criteria","groupKey":"screening","displayName":"Screening criteria","description":"Replaceable methodology for an evidence-led first assessment of a new investment opportunity.","kind":"methodology","sortOrder":10},
          {"documentId":"vc.document.deal_pipeline_screening_report_template","roleKey":"screening_report_template","groupKey":"screening","displayName":"Screening Report template","description":"Output structure for a compact, evidence-backed first assessment and next-step recommendation.","kind":"output_template","sortOrder":20},
          {"documentId":"vc.document.deal_pipeline_evaluation_criteria","roleKey":"evaluation_criteria","groupKey":"evaluation","displayName":"Evaluation criteria","description":"Replaceable methodology for deeper company, market, product, traction, team, and financing evaluation.","kind":"methodology","sortOrder":10},
          {"documentId":"vc.document.deal_pipeline_evaluation_report_template","roleKey":"evaluation_report_template","groupKey":"evaluation","displayName":"Evaluation Report template","description":"Output structure for the living evaluation report and its evidence-backed findings.","kind":"output_template","sortOrder":20},
          {"documentId":"vc.document.deal_pipeline_ic_criteria","roleKey":"decision_ic_criteria","groupKey":"decision","displayName":"IC criteria and guidance","description":"Replaceable methodology for assembling decision-relevant evidence and uncertainty for investment committee review.","kind":"methodology","sortOrder":10},
          {"documentId":"vc.document.deal_pipeline_ic_memo_template","roleKey":"decision_ic_memo_template","groupKey":"decision","displayName":"IC Memo template","description":"Output structure for the living investment committee memo.","kind":"output_template","sortOrder":20},
          {"documentId":"vc.document.deal_pipeline_decision_record_template","roleKey":"decision_record_template","groupKey":"decision","displayName":"Decision Record template","description":"Output structure for recording each distinct, explicitly confirmed investment decision.","kind":"output_template","sortOrder":30},
          {"documentId":"vc.document.deal_pipeline_term_sheet_review_policy","roleKey":"term_sheet_review_policy","groupKey":"term_sheet","displayName":"Term Sheet Review policy","description":"Policy boundaries and review method for supplied current and previous term sheets.","kind":"policy","sortOrder":10},
          {"documentId":"vc.document.deal_pipeline_term_sheet_review_template","roleKey":"term_sheet_review_template","groupKey":"term_sheet","displayName":"Term Sheet Review template","description":"Output structure for the living commercial term-sheet review.","kind":"output_template","sortOrder":20},
          {
            "documentId": "vc.document.initial_call_brief_template",
            "roleKey": "meeting_brief_template",
            "groupKey": "meetings",
            "displayName": "Meeting Brief template",
            "description": "Output structure for a meeting brief.",
            "kind": "output_template",
            "sortOrder": 10
          },
          {
            "documentId": "vc.document.customer_insights_summary_template",
            "roleKey": "meeting_summary_template",
            "groupKey": "meetings",
            "displayName": "Meeting Summary template",
            "description": "Output structure for a meeting summary.",
            "kind": "output_template",
            "sortOrder": 20
          }
        ]
      }
    },
    "fieldsSchema": [
      {
        "id": "field-round-stage",
        "key": "round_stage",
        "label": "Round stage",
        "kind": "enum",
        "required": false,
        "description": "Financing round the company is currently raising, not the Deal lifecycle state.",
        "options": [
          {
            "value": "pre_seed",
            "label": "Pre-seed"
          },
          {
            "value": "seed",
            "label": "Seed"
          },
          {
            "value": "series_a",
            "label": "Series A"
          },
          {
            "value": "series_b",
            "label": "Series B"
          },
          {
            "value": "series_c_plus",
            "label": "Series C or later"
          },
          {
            "value": "other",
            "label": "Other"
          }
        ]
      },
      {
        "id": "field-round-label",
        "key": "round_label",
        "label": "Round label",
        "kind": "text",
        "required": false,
        "description": "Optional company wording for a bridge, extension or otherwise unusual round."
      },
      {
        "id": "field-our-round-role",
        "key": "our_round_role",
        "label": "Our role in this round",
        "kind": "enum",
        "required": false,
        "description": "Role of the selected Fund in the current financing round. Unset means no role is recorded; neither option implies a committed investment. Review this value if the selected Fund changes.",
        "options": [
          {
            "value": "lead_or_co_lead",
            "label": "Lead or co-lead"
          },
          {
            "value": "non_lead",
            "label": "Investor, not leading"
          }
        ]
      },
      {
        "id": "field-other-investors",
        "key": "other_investors",
        "label": "Other investors",
        "kind": "organisation",
        "relationshipType": "round_investor",
        "cardinality": "many",
        "required": false,
        "description": "Organisations known to be involved in the current financing round, excluding our selected Fund. A link does not assert a signed commitment. Each Organisation appears at most once for this field and has one current role classification.",
        "roleOptions": [
          {
            "value": "lead_or_co_lead",
            "label": "Lead or co-lead"
          },
          {
            "value": "non_lead",
            "label": "Investor, not leading"
          },
          {
            "value": "undetermined",
            "label": "Role not known"
          }
        ]
      },
      {
        "id": "field-target-raise",
        "key": "target_raise",
        "label": "Target raise",
        "kind": "text",
        "required": false,
        "description": "Total amount the company aims to raise in this round, recorded as stated with any currency notation; not this firm's intended cheque."
      },
      {
        "id": "field-indicative-investment-amount",
        "key": "indicative_investment_amount",
        "label": "Indicative investment amount",
        "kind": "text",
        "required": false,
        "description": "Amount our selected Fund is contemplating investing in this Deal's current round, recorded as stated with currency notation; neither the company's target raise nor an investment commitment."
      },
      {
        "id": "field-instrument",
        "key": "instrument",
        "label": "Instrument",
        "kind": "text",
        "required": false,
        "description": "Proposed investment instrument for our contemplated participation in the current round, recorded in the terms used by the company or Fund; not evidence of agreed terms."
      },
      {
        "id": "field-valuation",
        "key": "valuation",
        "label": "Valuation",
        "kind": "text",
        "required": false,
        "description": "Company-stated or proposed valuation, recorded as stated with any currency notation; interpret with valuation basis and as-of date."
      },
      {
        "id": "field-valuation-basis",
        "key": "valuation_basis",
        "label": "Valuation basis",
        "kind": "enum",
        "required": false,
        "description": "Whether valuation amount is before or after this financing round.",
        "options": [
          {
            "value": "pre_money",
            "label": "Pre-money"
          },
          {
            "value": "post_money",
            "label": "Post-money"
          }
        ]
      },
      {
        "id": "field-valuation-as-of-date",
        "key": "valuation_as_of_date",
        "label": "Valuation as-of date",
        "kind": "date",
        "required": false,
        "description": "Date on which this valuation was stated or assessed."
      },
      {
        "id": "field-current-term-sheet-artifact-id",
        "key": "current_term_sheet_artifact_id",
        "label": "Current term sheet",
        "kind": "text",
        "required": false,
        "description": "Internal pointer to the current term sheet supplied for review; this is an input document, not the generated review.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-term-sheet-review-artifact-id",
        "key": "term_sheet_review_artifact_id",
        "label": "Term Sheet Review",
        "kind": "text",
        "required": false,
        "description": "Internal pointer to the latest generated Term Sheet Review artifact; display the linked review rather than the raw ID.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-screening-report-artifact-id",
        "key": "screening_report_artifact_id",
        "label": "Screening report",
        "kind": "text",
        "required": false,
        "description": "Internal pointer to the latest generated Screening Report artifact for this Deal; display the linked report rather than the raw ID.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-evaluation-report-artifact-id",
        "key": "evaluation_report_artifact_id",
        "label": "Evaluation report",
        "kind": "text",
        "required": false,
        "description": "Internal pointer to the latest generated Evaluation Report artifact for this Deal; display the linked report rather than the raw ID.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-ic-memo-artifact-id",
        "key": "ic_memo_artifact_id",
        "label": "IC memo",
        "kind": "text",
        "required": false,
        "description": "Internal pointer to the latest generated IC Memo artifact for this Deal; this memo is not the confirmed human decision.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-latest-decision-record-artifact-id",
        "key": "latest_decision_record_artifact_id",
        "label": "Decision Record",
        "kind": "text",
        "required": false,
        "description": "Internal pointer to the latest directly human-confirmed Decision Record. The V3 Assessment Documents group renders a permitted document link, never this raw ID or an independently editable decision field.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-arr",
        "key": "arr",
        "label": "ARR",
        "kind": "text",
        "required": false,
        "description": "Most recent company-stated annual recurring revenue, recorded as stated with any currency notation; not total annual revenue."
      },
      {
        "id": "field-arr-as-of-date",
        "key": "arr_as_of_date",
        "label": "ARR as-of date",
        "kind": "date",
        "required": false,
        "description": "Date to which the company-stated ARR amount applies."
      },
      {
        "id": "field-monthly-net-burn",
        "key": "monthly_net_burn",
        "label": "Monthly net burn",
        "kind": "text",
        "required": false,
        "description": "Company-reported net cash burn per month, recorded as stated with currency notation; interpret with its own reporting period and actual or forecast basis."
      },
      {
        "id": "field-burn-reporting-period",
        "key": "burn_reporting_period",
        "label": "Burn reporting period",
        "kind": "text",
        "required": false,
        "description": "Period and basis for monthly net burn, such as September 2026 actual or a July–September 2026 average; record the company-stated period rather than inferring a single date."
      },
      {
        "id": "field-cash-balance",
        "key": "cash_balance",
        "label": "Cash balance",
        "kind": "text",
        "required": false,
        "description": "Company-reported cash balance, recorded as stated with currency notation; interpret with its own as-of date and do not derive it from burn."
      },
      {
        "id": "field-cash-as-of-date",
        "key": "cash_as_of_date",
        "label": "Cash as-of date",
        "kind": "date",
        "required": false,
        "description": "Date to which the company-reported cash balance applies."
      },
      {
        "id": "field-deal-source",
        "key": "deal_source",
        "label": "Source",
        "kind": "enum",
        "required": false,
        "description": "Primary route through which this opportunity reached the firm; not a complete origination history. Direct inbound means the company or founder approached the firm directly.",
        "options": [
          {
            "value": "inbound",
            "label": "Direct inbound"
          },
          {
            "value": "referral",
            "label": "Referral"
          },
          {
            "value": "event",
            "label": "Event"
          },
          {
            "value": "portfolio_network",
            "label": "Portfolio network"
          },
          {
            "value": "outbound",
            "label": "Outbound"
          },
          {
            "value": "other",
            "label": "Other"
          }
        ]
      },
      {
        "id": "field-introducer",
        "key": "introducer",
        "label": "Introduced by",
        "kind": "person",
        "cardinality": "one",
        "required": false,
        "description": "Person who introduced this opportunity to the firm, when known. Organisation affiliation is a property of the selected Person, not an alternative target for this field.",
        "relationshipType": "deal_introducer"
      },
      {
        "id": "field-source-details",
        "key": "source_details",
        "label": "Source details",
        "kind": "text",
        "required": false,
        "description": "Optional context about how this opportunity reached the firm, such as the event and subsequent introduction; not a general Deal notes field or raw source URL."
      },
      {
        "id": "field-fund-id",
        "key": "fund_id",
        "label": "Fund",
        "kind": "text",
        "required": false,
        "description": "Stable ID of the Fund explicitly confirmed for this Deal. Optional at creation; displayed in the fixed header and excluded from Field Settings and body groups.",
        "optionSource": {
          "type": "workspaceVariableCollection",
          "path": "vc.funds",
          "valueKey": "id",
          "labelKey": "name",
          "statusKey": "status",
          "selectableStatuses": [
            "actively_investing"
          ],
          "hintKeys": [
            "stage",
            "sectors",
            "geographies"
          ]
        },
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-previous-term-sheet-artifact-id",
        "key": "previous_term_sheet_artifact_id",
        "label": "Previous term sheet",
        "kind": "text",
        "required": false,
        "description": "Internal pointer to an optional previous term sheet supplied for comparison by the Term Sheet Review task; retained for task use but not shown in the default V3 Deal Room layout.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-decision-record-artifact-ids",
        "key": "decision_record_artifact_ids",
        "label": "Decision Record Artifact IDs",
        "kind": "text",
        "required": false,
        "description": "Append-only ordered IDs for explicitly human-confirmed Decision Record artifacts.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-current-decision",
        "key": "current_decision",
        "label": "Decision Posture Projection",
        "kind": "enum",
        "required": false,
        "options": [
          {
            "value": "undecided",
            "label": "Undecided"
          },
          {
            "value": "proceed",
            "label": "Proceed"
          },
          {
            "value": "watch",
            "label": "Watch / Hold"
          },
          {
            "value": "conditional_approval",
            "label": "Conditional Approval"
          },
          {
            "value": "continue_evaluation",
            "label": "Continue Evaluation"
          },
          {
            "value": "pass",
            "label": "Pass"
          },
          {
            "value": "reapprove",
            "label": "Reapprove"
          }
        ],
        "description": "Current human-confirmed decision posture projected from the latest Decision Record; do not infer it from a report or transcript.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-decision-rationale",
        "key": "decision_rationale",
        "label": "Decision Rationale Projection",
        "kind": "text",
        "required": false,
        "description": "Rationale from the latest explicitly human-confirmed Decision Record, shown as a projection rather than an independent decision.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-decision-conditions",
        "key": "decision_conditions",
        "label": "Decision Conditions Projection",
        "kind": "text",
        "required": false,
        "description": "Conditions from the latest explicitly human-confirmed Decision Record, shown as a projection rather than an independent decision.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-company-name",
        "key": "company_name",
        "label": "Company Name",
        "kind": "text",
        "required": false,
        "placeholder": "Acme AI",
        "description": "Legacy company name kept as history. The Deal's confirmed Organisation is its company identity.",
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-company-domain",
        "key": "company_domain",
        "label": "Company Domain",
        "kind": "text",
        "required": false,
        "settingsPolicy": "excluded"
      },
      {
        "id": "field-company-logo-url",
        "key": "company_logo_url",
        "label": "Company Logo URL",
        "kind": "text",
        "required": false,
        "settingsPolicy": "excluded"
      }
    ],
    "lifecycleStates": ["screening", "evaluation", "decision", "term_sheet", "passed", "promoted_to_investment_execution", "archived"],
    "lifecycleTransitions": [
      {"from":"screening","to":"evaluation"},{"from":"screening","to":"passed"},{"from":"screening","to":"archived"},
      {"from":"evaluation","to":"decision"},{"from":"evaluation","to":"screening"},{"from":"evaluation","to":"passed"},{"from":"evaluation","to":"archived"},
      {"from":"decision","to":"term_sheet"},{"from":"decision","to":"evaluation"},{"from":"decision","to":"passed"},{"from":"decision","to":"archived"},
      {"from":"term_sheet","to":"decision"},{"from":"term_sheet","to":"passed"},{"from":"term_sheet","to":"promoted_to_investment_execution"},{"from":"term_sheet","to":"archived"}
    ],
    "projectTaskMappings": [
      {
        "id":"map-generate-refresh-screening-report","taskDefinitionTemplateId":"vc.generate_refresh_screening_report","taskDefinitionSlug":"generate-refresh-screening-report","projectScope":"project_instance",
        "inputMappings":[
          {"taskField":"company_name","source":"project.investmentSubject","sourcePath":"organisation.displayName","requiredForActivation":true},
          {"taskField":"organisation_id","source":"project.investmentSubject","sourcePath":"organisation.id","requiredForActivation":false},
          {"taskField":"fund_id","source":"project.field","sourcePath":"fund_id","requiredForActivation":false},
          {"taskField":"existing_screening_report_artifact_id","source":"project.field","sourcePath":"screening_report_artifact_id","requiredForActivation":false}
        ],
        "outputMappings":[{"taskField":"screening_report_artifact_id","target":"project.field","targetPath":"screening_report_artifact_id","requiredForCompletion":true}],
        "activationPolicy":{"mode":"manual_review","autoStartWhenRequiredInputsAvailable":false,"requiresHumanApproval":true,"createTaskWhenLifecycleStageEntered":false}
      },
      {
        "id":"map-generate-refresh-evaluation-report","taskDefinitionTemplateId":"vc.generate_refresh_evaluation_report","taskDefinitionSlug":"generate-refresh-evaluation-report","projectScope":"project_instance",
        "inputMappings":[
          {"taskField":"company_name","source":"project.investmentSubject","sourcePath":"organisation.displayName","requiredForActivation":true},
          {"taskField":"organisation_id","source":"project.investmentSubject","sourcePath":"organisation.id","requiredForActivation":false},
          {"taskField":"fund_id","source":"project.field","sourcePath":"fund_id","requiredForActivation":false},
          {"taskField":"screening_report_artifact_id","source":"project.field","sourcePath":"screening_report_artifact_id","requiredForActivation":false},
          {"taskField":"existing_evaluation_report_artifact_id","source":"project.field","sourcePath":"evaluation_report_artifact_id","requiredForActivation":false}
        ],
        "outputMappings":[{"taskField":"evaluation_report_artifact_id","target":"project.field","targetPath":"evaluation_report_artifact_id","requiredForCompletion":true}],
        "activationPolicy":{"mode":"manual_review","autoStartWhenRequiredInputsAvailable":false,"requiresHumanApproval":true,"createTaskWhenLifecycleStageEntered":false}
      },
      {
        "id":"map-prepare-refresh-ic-memo","taskDefinitionTemplateId":"vc.prepare_refresh_ic_memo","taskDefinitionSlug":"prepare-refresh-ic-memo","projectScope":"project_instance",
        "inputMappings":[
          {"taskField":"company_name","source":"project.investmentSubject","sourcePath":"organisation.displayName","requiredForActivation":true},
          {"taskField":"organisation_id","source":"project.investmentSubject","sourcePath":"organisation.id","requiredForActivation":false},
          {"taskField":"fund_id","source":"project.field","sourcePath":"fund_id","requiredForActivation":false},
          {"taskField":"evaluation_report_artifact_id","source":"project.field","sourcePath":"evaluation_report_artifact_id","requiredForActivation":false},
          {"taskField":"decision_record_artifact_ids","source":"project.field","sourcePath":"decision_record_artifact_ids","requiredForActivation":false},
          {"taskField":"term_sheet_review_artifact_id","source":"project.field","sourcePath":"term_sheet_review_artifact_id","requiredForActivation":false},
